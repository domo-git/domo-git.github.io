<style>
  /* ── EARTHY FALL LIGHT ───────────────────────────────────── */
  [data-theme="light"] {
    --bg:          #f5ede0;
    --bg2:         #ede0cd;
    --bg3:         #e3d2b8;
    --border:      rgba(139,58,15,0.22);
    --border2:     rgba(139,58,15,0.10);
    --accent:      #c4622d;
    --accent2:     rgba(196,98,45,0.12);
    --text:        #2c1810;
    --text2:       #7a4a30;
    --text3:       #b8865a;
    --nav-bg:      rgba(245,237,224,0.92);
    --scanline:    rgba(139,58,15,0.015);
    --rain-opacity:0.18;
    --hover-row:   rgba(139,58,15,0.04);
    --card-scan:   none;
    /* tier colours */
    --tier-nov:    #3d6b20;
    --tier-int:    #1a5a8a;
    --tier-hrd:    #8a5500;
    --tier-exp:    #8a1e1e;
    --pip-nov:     rgba(61,107,32,0.18);
    --pip-int:     rgba(26,90,138,0.18);
    --pip-hrd:     rgba(138,85,0,0.18);
    --pip-exp:     rgba(138,30,30,0.18);
    --green-dim:   rgba(61,107,32,0.20);
    --green-glow:  rgba(196,98,45,0.10);
    --green:       #c4622d;
    --red:         #8a1e1e;
    --yellow:      #8a5500;
    --blue:        #1a5a8a;
    --cyan:        #2a6a5a;
    --purple:      #6a2a6a;
  }

  /* ── CYBERPUNK CHARTREUSE DARK ───────────────────────────── */
  [data-theme="dark"] {
    --bg:          #04060a;
    --bg2:         #080c12;
    --bg3:         #0d1118;
    --border:      rgba(180,255,0,0.18);
    --border2:     rgba(180,255,0,0.07);
    --accent:      #b4ff00;
    --accent2:     rgba(180,255,0,0.09);
    --text:        #e8f4e0;
    --text2:       #5a7a4a;
    --text3:       #2a3a1a;
    --nav-bg:      rgba(4,6,10,0.94);
    --scanline:    rgba(180,255,0,0.012);
    --rain-opacity:0.22;
    --hover-row:   rgba(180,255,0,0.03);
    --card-scan:   repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(180,255,0,0.012) 3px,rgba(180,255,0,0.012) 6px);
    /* tier colours */
    --tier-nov:    #b4ff00;
    --tier-int:    #ff2d78;
    --tier-hrd:    #ffe000;
    --tier-exp:    #ff4400;
    --pip-nov:     rgba(180,255,0,0.10);
    --pip-int:     rgba(255,45,120,0.10);
    --pip-hrd:     rgba(255,224,0,0.10);
    --pip-exp:     rgba(255,68,0,0.10);
    --green-dim:   rgba(180,255,0,0.20);
    --green-glow:  rgba(180,255,0,0.09);
    --green:       #b4ff00;
    --red:         #ff4400;
    --yellow:      #ffe000;
    --blue:        #4488ff;
    --cyan:        #00ddff;
    --purple:      #cc00cc;
  }

  
  
  :root{--font-mono:'Share Tech Mono',monospace;--font-ui:'Rajdhani',sans-serif;}
  *{margin:0;padding:0;box-sizing:border-box;}
  body{background:var(--bg);color:var(--text);font-family:var(--font-ui);font-size:16px;line-height:1.6;min-height:100vh;transition:background 0.25s,color 0.25s;}
  body::before{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 2px,var(--scanline) 2px,var(--scanline) 4px);pointer-events:none;z-index:9999;}
  #matrix-rain{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0;opacity:var(--rain-opacity);}
  nav,.container{position:relative;z-index:1;}
  nav{background:var(--nav-bg);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:56px;position:sticky;top:0;z-index:100;transition:background 0.25s,border-color 0.25s;}
  .nav-brand{font-family:var(--font-mono);color:var(--green);font-size:0.85rem;letter-spacing:0.05em;text-decoration:none;}
  .nav-links{display:flex;list-style:none;align-items:center;}
  .nav-links a{color:var(--text-dim);text-decoration:none;font-family:var(--font-ui);font-weight:600;font-size:0.8rem;letter-spacing:0.1em;text-transform:uppercase;padding:0 1.2rem;height:56px;display:flex;align-items:center;border-bottom:2px solid transparent;transition:all 0.2s;}
  .nav-links a:hover,.nav-links a.active{color:var(--text-bright);border-bottom-color:var(--green);}
  .theme-toggle-btn{font-family:var(--font-mono);font-size:0.72rem;color:var(--text-dim);background:var(--green-glow);border:1px solid var(--border-accent);border-radius:4px;padding:0.3rem 0.75rem;cursor:pointer;letter-spacing:0.08em;margin-left:1rem;transition:color 0.2s,border-color 0.2s;}
  .theme-toggle-btn:hover{color:var(--green);border-color:var(--green);}
  .container{max-width:960px;margin:0 auto;padding:2.5rem 2rem;}
  .page-header{margin-bottom:2.5rem;padding-bottom:1.5rem;border-bottom:1px solid var(--border);}
  .breadcrumb{font-family:var(--font-mono);font-size:0.75rem;color:var(--text-dim);margin-bottom:1rem;}
  .breadcrumb a{color:var(--green);text-decoration:none;}
  .breadcrumb span{margin:0 0.4rem;}
  .page-title{font-size:1.8rem;font-weight:700;color:var(--text-bright);letter-spacing:0.02em;text-transform:uppercase;display:flex;align-items:center;gap:0.75rem;}
  .page-title::before{content:'//';color:var(--green);font-family:var(--font-mono);font-size:1.2rem;animation:glitch 5s infinite;}
  @keyframes glitch{0%,88%,100%{transform:translate(0)}89%{transform:translate(-2px,1px)}90%{transform:translate(2px,-1px)}91%,94%{transform:translate(0)}93%{transform:translate(1px,1px)}}
  .page-subtitle{margin-top:0.5rem;color:var(--text-dim);font-size:0.95rem;font-weight:500;}
  .section{margin-bottom:2.5rem;}
  .section-title{font-family:var(--font-ui);font-weight:700;font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--green);margin-bottom:1.25rem;display:flex;align-items:center;gap:0.5rem;position:relative;overflow:hidden;}
  .section-title::before{content:'';display:inline-block;width:3px;height:14px;background:var(--green);border-radius:2px;animation:barPulse 2.5s ease-in-out infinite;}
  .section-title::after{content:'';position:absolute;top:0;left:-60%;width:60%;height:100%;background:linear-gradient(90deg,transparent,var(--green-glow),transparent);animation:sweep 4s ease-in-out infinite;}
  @keyframes barPulse{0%,100%{opacity:1}50%{opacity:0.4}}
  @keyframes sweep{0%{left:-60%}50%{left:160%}100%{left:160%}}

  /* CATEGORY LABEL */
  .cat-label{font-family:var(--font-mono);font-size:0.7rem;color:var(--text-dim);letter-spacing:2px;margin-bottom:12px;padding-left:2px;}

  /* TOOL GRID */
  .tool-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;margin-bottom:2rem;}

  .tool-card{
    background:var(--bg2);border:1px solid var(--border);border-radius:6px;
    padding:16px 14px;text-decoration:none;display:flex;flex-direction:column;gap:6px;
    transition:border-color 0.2s,transform 0.15s;color:inherit;
  }
  .tool-card:hover{border-color:var(--green-dim);transform:translateY(-2px);}

  .tool-card-top{display:flex;align-items:center;gap:10px;}
  .tool-icon{font-size:18px;line-height:1;flex-shrink:0;}
  .tool-name{font-family:var(--font-mono);font-size:11px;color:var(--text-bright);letter-spacing:1.5px;font-weight:600;}
  .tool-cat{font-family:var(--font-mono);font-size:9px;color:var(--green);background:var(--green-glow);border:1px solid var(--green-dim);border-radius:3px;padding:1px 6px;letter-spacing:1px;align-self:flex-start;}
  .tool-desc{font-family:var(--font-ui);font-size:12px;color:var(--text-dim);line-height:1.5;margin-top:2px;}
  .tool-link{font-family:var(--font-mono);font-size:10px;color:var(--green);margin-top:auto;padding-top:6px;opacity:0.75;}
  .tool-card:hover .tool-link{opacity:1;}

  /* METHODOLOGY */
  .method-steps{background:var(--bg2);border:1px solid var(--border);border-radius:6px;overflow:hidden;}
  .method-step{display:flex;gap:16px;align-items:flex-start;padding:14px 18px;border-bottom:1px solid var(--border);font-size:0.9rem;}
  .method-step:last-child{border-bottom:none;}
  .method-num{font-family:var(--font-mono);font-size:0.68rem;color:var(--green);background:var(--green-glow);border:1px solid var(--green-dim);border-radius:3px;padding:0.15rem 0.5rem;white-space:nowrap;margin-top:2px;flex-shrink:0;}
  .method-text{color:var(--text-dim);line-height:1.55;}
  .method-text strong{color:var(--text);}

  /* FRAMEWORK TABLE */
  .fw-table{width:100%;border-collapse:collapse;background:var(--bg2);border:1px solid var(--border);border-radius:6px;overflow:hidden;font-size:0.875rem;}
  .fw-table thead tr{background:var(--bg3);border-bottom:1px solid var(--border);}
  .fw-table th{font-family:var(--font-mono);font-size:0.68rem;color:var(--green);text-transform:uppercase;letter-spacing:0.1em;padding:0.75rem 1rem;text-align:left;}
  .fw-table td{padding:0.75rem 1rem;border-bottom:1px solid var(--border);color:var(--text-dim);vertical-align:top;line-height:1.5;}
  .fw-table tr:last-child td{border-bottom:none;}
  .fw-table tr:hover td{background:var(--hover-row);}
  .fw-table td:first-child{font-family:var(--font-mono);font-size:0.78rem;color:var(--cyan);white-space:nowrap;}
  .fw-table td:nth-child(2){color:var(--text);font-weight:500;}

  @media(max-width:600px){.container{padding:1.5rem 1rem;}.nav-links a{padding:0 0.6rem;font-size:0.72rem;}.tool-grid{grid-template-columns:repeat(2,1fr);}}

    /* ── ORBITRON NAME ─────────────────────────────────────── */
    .page-title, .hero-name {
      font-family: 'Orbitron', var(--font-mono, monospace) !important;
      font-weight: 900 !important;
      color: var(--accent) !important;
      letter-spacing: 5px;
    }
    [data-theme="dark"] .page-title,
    [data-theme="dark"] .hero-name {
      filter: drop-shadow(0 0 8px var(--accent));
    }
    /* ── CIRCUIT HERO CORNERS ─────────────────────────────── */
    .page-header {
      position: relative;
    }
    .page-header::before {
      content: '';
      position: absolute; inset: 0; pointer-events: none;
      background:
        linear-gradient(90deg, var(--accent) 0%, transparent 40%) top left / 50px 0.5px no-repeat,
        linear-gradient(180deg, var(--accent) 0%, transparent 60%) top left / 0.5px 34px no-repeat,
        linear-gradient(270deg, var(--accent) 0%, transparent 40%) bottom right / 50px 0.5px no-repeat,
        linear-gradient(0deg, var(--accent) 0%, transparent 60%) bottom right / 0.5px 34px no-repeat;
      opacity: 0.4;
    }
    /* ── WHOAMI CARD (light) ─────────────────────────────── */
    .whoami-card {
      border: 0.5px solid var(--border);
      border-radius: 5px; overflow: hidden;
      margin-bottom: 16px; display: none;
    }
    [data-theme="light"] .whoami-card { display: block; }
    .wc-header {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 13px; border-bottom: 0.5px solid var(--border);
      background: var(--bg2);
    }
    .wc-avatar {
      width: 28px; height: 28px; border-radius: 50%;
      background: var(--accent2); border: 0.5px solid var(--accent);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-mono, monospace); font-size: 10px;
      color: var(--accent); font-weight: 700; flex-shrink: 0;
    }
    .wc-name { font-family: var(--font-mono, monospace); font-size: 11px; color: var(--text); font-weight: 600; letter-spacing: 1px; }
    .wc-role { font-family: var(--font-mono, monospace); font-size: 9px; color: var(--text3); letter-spacing: 1px; margin-top: 2px; }
    .wc-row {
      display: flex; align-items: center;
      border-bottom: 0.5px solid var(--border2);
      font-family: var(--font-mono, monospace); font-size: 10px;
      background: var(--bg2);
    }
    .wc-row:last-child { border-bottom: none; }
    .wc-key { width: 70px; flex-shrink: 0; padding: 6px 11px; color: var(--text3); border-right: 0.5px solid var(--border2); letter-spacing: 1px; }
    .wc-val { padding: 6px 11px; color: var(--text2); flex: 1; }
    .wc-val em { color: var(--accent); font-style: normal; font-weight: 700; }
    .online-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #4a8a2a; margin-right: 5px; vertical-align: middle; }
    /* ── WHOAMI TERMINAL (dark) ─────────────────────────── */
    .whoami-terminal {
      font-family: var(--font-mono, monospace); font-size: 11px; line-height: 2;
      padding: 11px 13px; border: 0.5px solid var(--border);
      border-radius: 4px; background: rgba(180,255,0,0.04);
      color: var(--text2); margin-bottom: 16px; display: none;
    }
    .whoami-terminal::before {
      content: 'OPSEC@portfolio:~$ whoami';
      display: block; font-size: 10px; color: var(--text3);
      margin-bottom: 5px; letter-spacing: 1px;
    }
    [data-theme="dark"] .whoami-terminal { display: block; }
    .wt-key { color: var(--accent); }
    .wt-val { color: var(--text2); }
    .wt-good { color: #4aaa2a; }
    .wt-cursor {
      display: inline-block; width: 7px; height: 12px;
      background: var(--accent); vertical-align: middle;
      animation: blink-wt 1s step-end infinite;
    }
    @keyframes blink-wt { 0%,100%{opacity:1} 50%{opacity:0} }
    /* ── TIER COLOURS ────────────────────────────────────── */
    .tier-novice       { color: var(--tier-nov) !important; border-color: var(--tier-nov) !important; background: var(--pip-nov) !important; }
    .tier-intermediate { color: var(--tier-int) !important; border-color: var(--tier-int) !important; background: var(--pip-int) !important; }
    .tier-hard         { color: var(--tier-hrd) !important; border-color: var(--tier-hrd) !important; background: var(--pip-hrd) !important; }
    .tier-expert       { color: var(--tier-exp) !important; border-color: var(--tier-exp) !important; background: var(--pip-exp) !important; }
    .tier-pip.active[data-tier="0"] { border-color: var(--tier-nov) !important; color: var(--tier-nov) !important; background: var(--pip-nov) !important; }
    .tier-pip.active[data-tier="1"] { border-color: var(--tier-int) !important; color: var(--tier-int) !important; background: var(--pip-int) !important; }
    .tier-pip.active[data-tier="2"] { border-color: var(--tier-hrd) !important; color: var(--tier-hrd) !important; background: var(--pip-hrd) !important; }
    .tier-pip.active[data-tier="3"] { border-color: var(--tier-exp) !important; color: var(--tier-exp) !important; background: var(--pip-exp) !important; }
    /* ── CRT SCANLINES on dark cards ────────────────────── */
    [data-theme="dark"] .card,
    [data-theme="dark"] .proj-card,
    [data-theme="dark"] .project-card,
    [data-theme="dark"] .news-feed,
    [data-theme="dark"] .room-terminal,
    [data-theme="dark"] .soc-terminal {
      background-image: repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(180,255,0,0.012) 3px,rgba(180,255,0,0.012) 6px) !important;
    }

  </style>
</head>
